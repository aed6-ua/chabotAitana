{
    "global": {
        "id": "PAT",
        "assistant": "RAGAssistant",
        "retriever": "SentenceTransformerRetriever",
        "embeddings": "SentenceTransformerEmbeddings",
        "log": "Y",
        "log_folder": "log/",
        "verbose": "Y",
        "data_encoding": "utf-8",
        "token_error": "ERROR",
        "ip": "0.0.0.0",
        "port": "9001"
    },

    "RAGAssistant": {
        "retriever": "SentenceTransformerRetriever",
        "embeddings": "SentenceTransformerEmbeddings",
        "LLM" : "LocalLLM",
        "RAG_DB_Folder": "PAT",
        "vector_folder": "storage/",
        "prompt_settings": {
            "language": "es",
            "introduction": "Eres Aitana, el asistente virtual de la Universidad de Alicante. Estas aquí para ayudar con información acerca del programa de acción tutorial llamado PAT. Tu objetivo es proporcionar respuestas precisas y útiles a tus preguntas. Utiliza los textos proporcionados delimitados por comillas triples para responder preguntas. No referencies directamente al contexto facilitado. Si no se puede encontrar la respuesta en los textos, escribe: No pude encontrar una respuesta.",
            "context": ""
        },
        "error_msg": "I'm sorry, I encountered an error processing your request."
    },
    
    "GPTLLM": {
        "model_name": "gpt-3.5-turbo",
        "memory_context_size": 0,
        "temperature": 0.25,
        "max_tokens": 200
    },

    "LlamaIndexLLM": {
        "model_name": "gpt-3.5-turbo",
        "memory_context_size": 0,
        "temperature": 0.25,
        "max_tokens": 200
    },

    "LocalLLM": {
        "model_name": "llama3.1",
        "server_url": " http://172.18.0.48",
        "server_port": 11434,
        "server_endPoint": "/api/chat",
        "stream": false,
        "temperature": 0.01,
        "max_tokens": 500
    },
    
    "SentenceTransformerRetriever": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "%_sim_relevance": 40,

        "data_folder": "data/",
        "data_filename": "vectorstore.index",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "LlamaIndexRetriever": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "%_sim_relevance": 25,

        "data_folder": "data/",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "SentenceTransformerEmbeddings": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "chunk_size": 1000,
        "chunk_overlap": 32,

        "data_folder": "data/",
        "data_filename": "vectorstore.index",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "LlamaindexEmbeddings": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "chunk_size": 1000,
        "chunk_overlap": 32,

        "data_folder": "data/",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "special_tokens": {
        "model": "<model>",
        "error": "<error>",
        "fall_back": "<fall_back>",
        "llm": "<llm>"
    }
}
  
