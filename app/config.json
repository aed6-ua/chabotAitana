{
    "global": {
        "assistant": "GPTAssistant",
        "retriever": "LlamaIndexRetriever",
        "embeddings": "SentenceTransformerEmbeddings",
        "log": "Y",
        "log_folder": "log/",
        "verbose": "Y",
        "data_encoding": "utf-8"
    },
    
    "GPTAssistant": {
        "model_name": "gpt-3.5-turbo",
        "memory_context_size": 0,
        "temperature": 0.01,
        "max_tokens": 500
    },

    "LlamaIndexAssistant": {
        "model_name": "gpt-3.5-turbo",
        "memory_context_size": 0,
        "temperature": 0.01,
        "max_tokens": 500
    },

    "LocalAssistant": {
        "serverURL": "172.25.2.137",
        "serverPort": 8000,
        "temperature": 0.01,
        "max_tokens": 500
    },
    
    "SentenceTransformerRetriever": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "%_sim_relevance": 40,

        "data_folder": "data/",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "LlamaIndexRetriever": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "%_sim_relevance": 25,

        "data_folder": "data/",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "SentenceTransformerEmbeddings": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "chunk_size": 1000,
        "chunk_overlap": 32,

        "data_folder": "data/",
        "data_filename": "vectorstore.index",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "LlamaindexEmbeddings": {
        "model_name": "hackathon-pln-es/paraphrase-spanish-distilroberta",
        "num_chunks": 5,
        "chunk_size": 1000,
        "chunk_overlap": 32,

        "data_folder": "data/",
        "model_folder": "models/",
        "vector_folder": "storage/"
    },

    "special_tokens": {
        "model": "<model>",
        "error": "<error>",
        "fall_back": "<fall_back>",
        "llm": "<llm>"
    }
}
  
